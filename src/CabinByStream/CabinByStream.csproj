<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Cabin by Stream: a flowery meadow at dusk, a small cottage with white
    smoke rising from its chimney, a stream with fish, squirrels running
    around the trees, and fireflies lighting up over the grass.

    A Windows screensaver is just a normal .exe program whose file name
    ends in .scr instead of .exe. So we build a normal WinExe here, and the
    publish script (scripts/publish.ps1) renames CabinByStream.exe to
    CabinByStream.scr at the end.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>CabinByStream</AssemblyName>
    <RootNamespace>CabinByStream</RootNamespace>

    <!--
      "Per monitor DPI aware": tells Windows "I will handle high-resolution
      screens myself, do not blow my window up and blur it." Without this, on a
      laptop set to 150% scaling Windows would render us small and stretch us,
      and the fine grass and flowers would go fuzzy.
    -->
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>

    <Product>Cabin by Stream Screensaver</Product>
    <Company>Peckworks</Company>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Peckworks.Screensavers.Core\Peckworks.Screensavers.Core.csproj" />
  </ItemGroup>

</Project>
