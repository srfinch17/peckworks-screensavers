<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Christmas: snow falling over a snowy night, pines strung with pastel
    lights that twinkle, a cabin with lit windows, and Santa's sleigh crossing
    the sky behind the trees with Rudolph's nose glowing out front.

    A Windows screensaver is just a normal .exe program whose file name
    ends in .scr instead of .exe. So we build a normal WinExe here, and the
    publish script (scripts/publish.ps1) renames Christmas.exe to
    Christmas.scr at the end.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Christmas</AssemblyName>
    <RootNamespace>Christmas</RootNamespace>

    <!--
      "Per monitor DPI aware": tells Windows "I will handle high-resolution
      screens myself, do not blow my window up and blur it." Without this, on a
      laptop set to 150% scaling Windows would render us small and stretch us,
      and the little lights would go fuzzy.
    -->
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>

    <Product>Christmas Screensaver</Product>
    <Company>Peckworks</Company>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Peckworks.Screensavers.Core\Peckworks.Screensavers.Core.csproj" />
  </ItemGroup>

</Project>
